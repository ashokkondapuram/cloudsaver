{
  "name": "cloudsaver-web-dashboard",
  "version": "1.8.1",
  "private": true,
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "atlas:verify": "npm run typecheck && node scripts/atlas-contrast-audit.mjs && node unit/atlas-rollout-operations.test.mjs && node unit/atlas-contracts.test.mjs && node unit/atlas-workspace-notices.test.mjs",
    "test:e2e": "playwright test",
    "test:enterprise-ui": "playwright test --project=enterprise-ui",
    "ui:edge": "playwright open --browser msedge http://127.0.0.1:3000/resources"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@nivo/core": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@nivo/scales": "^0.99.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.13.12",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2"
  }
}
