# syntax=docker/dockerfile:1
FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
COPY requirements.txt .
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export PIP_CERT=/run/secrets/proxy_ca; fi; \
    pip install --no-cache-dir -r requirements.txt && useradd --uid 10001 --create-home appuser && \
    mkdir -p /app/data /home/appuser/.azure && \
    chown appuser:appuser /app/data /home/appuser/.azure && chmod 0700 /home/appuser/.azure
# Developer sign-in only: Azure CLI in an isolated venv so its pins never touch the app.
ARG INSTALL_AZURE_CLI=false
RUN --mount=type=secret,id=proxy_ca \
    if [ "$INSTALL_AZURE_CLI" = "true" ]; then \
      if [ -f /run/secrets/proxy_ca ]; then export PIP_CERT=/run/secrets/proxy_ca; fi; \
      python -m venv /opt/azure-cli && /opt/azure-cli/bin/pip install --no-cache-dir azure-cli && \
      ln -s /opt/azure-cli/bin/az /usr/local/bin/az; \
    fi
# Dockerfile.services.dockerignore strictly whitelists runtime source paths.
COPY --chown=appuser:appuser . .
USER appuser
EXPOSE 8000 8001 8002 8003 8004
CMD ["uvicorn", "services.gateway:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
