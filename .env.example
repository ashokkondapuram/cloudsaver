# Documentation only: no file is loaded automatically.
CLOUDSAVER_MODE=azure
CLOUDSAVER_DB=data/cloudsaver.sqlite3
# Tenant directory. "database" (Compose default) stores workspaces in Postgres and
# lets tenant admins edit schedules and alerts from the dashboard; "env" reads only
# CLOUDSAVER_TENANTS. In database mode CLOUDSAVER_TENANTS seeds the registry once.
CLOUDSAVER_TENANT_REGISTRY=env
CLOUDSAVER_TENANTS=[]
# Docker Compose only: generate separate URL-safe passwords, never commit .env.
POSTGRES_PASSWORD=
CLOUDSAVER_DB_PASSWORD=

# Keyless cloud identity: no client secrets, access keys or service-account keys.
# managed_identity: the Azure user-assigned managed identity federates into
#   Azure (multi-tenant app FIC), AWS (AssumeRoleWithWebIdentity) and GCP (WIF).
# developer: local az / aws sso / gcloud ADC sign-in (compose.override.example.yaml).
CLOUDSAVER_CLOUD_IDENTITY=managed_identity
# Client ID of the user-assigned managed identity (passed to containers as AZURE_CLIENT_ID).
AZURE_MANAGED_IDENTITY_CLIENT_ID=
# federated: MI -> multi-tenant app via federated credential; direct: MI reads its own tenant.
CLOUDSAVER_AZURE_ACCESS=federated
CLOUDSAVER_AZURE_APP_CLIENT_ID=
# AWS hub role trusting the Entra issuer; per-account roles trust the hub with ExternalId=tenant ID.
CLOUDSAVER_AWS_HUB_ROLE_ARN=
CLOUDSAVER_AWS_TOKEN_AUDIENCE=api://AzureADTokenExchange
# //iam.googleapis.com/projects/<number>/locations/global/workloadIdentityPools/<pool>/providers/<provider>
CLOUDSAVER_GCP_WORKLOAD_PROVIDER=
CLOUDSAVER_GCP_TOKEN_AUDIENCE=api://AzureADTokenExchange
# Developer mode only: bake the Azure CLI into the image.
CLOUDSAVER_INSTALL_AZURE_CLI=false
# Identity-service runs in the separate platform project (platform/); CloudSaver reaches it over the
# external platform-link network. Plans, billing and workspace keys are managed in the platform portal.
# One caller token per service; scripts/setup_compose.py generates them and prints only their SHA-256 digests.
CLOUDSAVER_IDENTITY_URL=http://identity-service:8005
CLOUDSAVER_IDENTITY_TOKEN_GATEWAY=
CLOUDSAVER_IDENTITY_TOKEN_TENANT=
CLOUDSAVER_IDENTITY_TOKEN_SCANNER=
CLOUDSAVER_IDENTITY_TOKEN_ANALYTICS=
CLOUDSAVER_IDENTITY_TOKEN_NOTIFICATION=
# Positive verify cache in seconds (0–30); evictions arrive through the identity events long-poll.
CLOUDSAVER_IDENTITY_CACHE_SECONDS=15
# Workspace-key rollout: local -> shadow -> identity, then CLOUDSAVER_DIRECTORY_MODE=cutover.
CLOUDSAVER_KEY_VERIFIER=local
CLOUDSAVER_DIRECTORY_MODE=registry
# Platform switches. In database mode these only seed the first value; change them in the platform portal (http://127.0.0.1:3100).
# Each workspace then picks manual, daily or hourly scans within its plan.
CLOUDSAVER_SCHEDULED_SCANS=false
CLOUDSAVER_AUTOMATED_ALERTS=false
CLOUDSAVER_SCHEDULER_TICK_SECONDS=300
# Standalone API only; Compose enables the shared lease automatically.
CLOUDSAVER_DISTRIBUTED_SCAN_LOCK=false

# Authentication is explicit: workspace keys or verified Entra delegated access tokens.
CLOUDSAVER_AUTH_MODE=workspace
CLOUDSAVER_ENTRA_AUDIENCE=
# Cloud onboarding (role trust, workload identity): see docs/CLOUD_SOURCES.md.
# Prometheus token bindings need an operator-owned Compose override.
# CLOUDSAVER_PROMETHEUS_TOKEN_PRIMARY=
# v0.7 GitOps is disabled until an operator approves repository bindings and an App.
CLOUDSAVER_GITOPS_TARGETS=[]
CLOUDSAVER_GITOPS_PUBLISH=false
CLOUDSAVER_GITHUB_APP_ID=
CLOUDSAVER_GITHUB_APP_PRIVATE_KEY=
# Trusted JSON only: e.g. {"required_tags":["Owner"],"max_monthly_increase_usd":"100"}
CLOUDSAVER_PLAN_POLICY={}

# Durable delivery is opt-in. Targets are explicitly bound to ONE tenant each.
# Store webhook secrets in env/mounted secret configuration, never in target JSON.
CLOUDSAVER_DELIVERY_ENABLED=false
CLOUDSAVER_NOTIFICATION_TARGETS=[]
# Example target: [{"target_id":"finops","tenant_id":"<tenant UUID>","channel":"slack","url_env":"CLOUDSAVER_WEBHOOK_PRIMARY"}]
CLOUDSAVER_WEBHOOK_PRIMARY=
# Additional CLOUDSAVER_WEBHOOK_* variables must be passed to scanner-service and
# delivery-dispatcher (and scan-worker for automatic alerts) via a private override.

# v0.7.2 durable interactive Azure jobs (requires worker + dispatcher).
CLOUDSAVER_INTERACTIVE_JOBS=false
# Exact comma-separated browser origins; empty disables cross-origin access.
CLOUDSAVER_ALLOWED_ORIGINS=
# Connection budget PER process; budget replicas and workers before increasing.
CLOUDSAVER_DB_POOL_SIZE=2
CLOUDSAVER_DB_MAX_OVERFLOW=3
CLOUDSAVER_DB_POOL_TIMEOUT=5
CLOUDSAVER_DB_POOL_RECYCLE=1800

# v0.9.0 optional keyless AI advisory. Operator-owned per-tenant targets only.
# See docs/ASSESSMENT_AI.md for schemas, IAM, data handling and acceptance limits.
CLOUDSAVER_AI_ENABLED=false
CLOUDSAVER_AI_TARGETS=[]
CLOUDSAVER_AI_HOURLY_ATTEMPTS=10
