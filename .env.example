# Documentation only: no file is loaded automatically.
CLOUDSAVER_MODE=demo
CLOUDSAVER_DB=data/cloudsaver.sqlite3
# Generate a random key with python -c "import secrets; print(secrets.token_urlsafe(32))"
DEMO_ACCESS_KEY=
# Live mode: use trusted operator configuration, never accept tenant/subscription IDs from requests.
CLOUDSAVER_TENANTS=[]
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Docker Compose only: generate separate URL-safe passwords, never commit .env.
POSTGRES_PASSWORD=
CLOUDSAVER_DB_PASSWORD=
# Optional aggregate-only notification destination configured by the operator.
CLOUDSAVER_NOTIFICATION_WEBHOOK=
# Optional credential provider. Key Vault never falls back to environment credentials.
CLOUDSAVER_CREDENTIAL_PROVIDER=env
AZURE_KEYVAULT_URL=
AZURE_KEYVAULT_AUTH=managed_identity
AZURE_KEYVAULT_MANAGED_IDENTITY_CLIENT_ID=
AZURE_KEYVAULT_CACHE_TTL_SECONDS=300
# Stripe webhook verification (Checkout has separate configuration below).
STRIPE_WEBHOOK_SECRET=
CLOUDSAVER_STRIPE_CUSTOMERS=
STRIPE_PRICE_TIERS=
# Scheduled services require migrations and explicit operator activation.
CLOUDSAVER_SCHEDULED_SCANS=false
CLOUDSAVER_SCAN_INTERVAL_SECONDS=3600
CLOUDSAVER_AUTOMATED_ALERTS=false
# Standalone API only; Compose enables the shared lease automatically.
CLOUDSAVER_DISTRIBUTED_SCAN_LOCK=false

# Authentication is explicit: workspace keys or verified Entra delegated access tokens.
CLOUDSAVER_AUTH_MODE=workspace
CLOUDSAVER_ENTRA_AUDIENCE=
# Checkout is disabled until a secret, HTTPS return URL and persisted customer mapping exist.
STRIPE_SECRET_KEY=
CLOUDSAVER_BILLING_RETURN_URL=
# GCP ADC / AWS named profiles / Prometheus: see docs/CLOUD_SOURCES.md.
# Credential files and token bindings need an operator-owned Compose override.
# GOOGLE_APPLICATION_CREDENTIALS=/run/cloud/gcp-credentials.json
# CLOUDSAVER_PROMETHEUS_TOKEN_PRIMARY=
