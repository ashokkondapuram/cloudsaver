# CloudSaver environment (documentation only — nothing loads this file automatically).
#
# Full reference: docs/ENVIRONMENT.md
# Generate a real, untracked .env (mode 0600, never commit it):
#   python3 scripts/setup_compose.py
# Then register service tokens with the platform:
#   (cd platform && python3 scripts/setup_platform.py --add-callers ../.env)
# Local Docker: make platform-up, then make up (see docs/ENVIRONMENT.md).

# -----------------------------------------------------------------------------
# Core mode and data store
# -----------------------------------------------------------------------------

# Required. Only supported value: azure.
CLOUDSAVER_MODE=azure

# Standalone API (no Compose): SQLite path. Ignored when CLOUDSAVER_DATABASE_URL is set.
CLOUDSAVER_DB=data/cloudsaver.sqlite3

# Standalone default: env (read CLOUDSAVER_TENANTS only).
# Docker Compose overrides to database (Postgres registry); do not set in .env for Compose.
CLOUDSAVER_TENANT_REGISTRY=env

# JSON array of workspace bootstrap rows. setup_compose.py writes [].
# In database mode: seeds the registry once; manage workspaces in the platform portal afterward.
CLOUDSAVER_TENANTS=[]

# development | production — not a product mode label. development issues cs_test_ workspace keys;
# operator-key portal sign-in is refused when production. setup_compose.py sets development for local Docker.
CLOUDSAVER_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Docker Compose — Postgres (required for local stack)
# -----------------------------------------------------------------------------

# Required for Compose. URL-safe random hex; used by postgres container and migration job only.
POSTGRES_PASSWORD=

# Required for Compose. URL-safe random hex; runtime role cloudsaver_app.
# CLOUDSAVER_DATABASE_URL and CLOUDSAVER_MIGRATION_URL are built in compose.yaml — not set here.
CLOUDSAVER_DB_PASSWORD=

# Optional. Migration 0011 registry export role; leave empty unless you use export tooling.
CLOUDSAVER_REGISTRY_EXPORT_PASSWORD=

# Per-process SQLAlchemy pool (Compose default matches these).
CLOUDSAVER_DB_POOL_SIZE=2
CLOUDSAVER_DB_MAX_OVERFLOW=3
CLOUDSAVER_DB_POOL_TIMEOUT=5
CLOUDSAVER_DB_POOL_RECYCLE=1800

# REDIS_URL is set per service in compose.yaml (e.g. /0 gateway, /1 scanner/workers) — not in .env.

# -----------------------------------------------------------------------------
# Keyless cloud resource access
# See docs/CLOUD_SOURCES.md and docs/MANAGED_IDENTITY_ROLES.md.
# -----------------------------------------------------------------------------

# managed_identity | developer
# setup_compose.py sets developer for local sign-in (use compose.override.example.yaml).
# compose.yaml default if unset: managed_identity.
CLOUDSAVER_CLOUD_IDENTITY=managed_identity

# User-assigned managed identity client ID (non-secret). Compose maps to AZURE_CLIENT_ID in containers.
AZURE_MANAGED_IDENTITY_CLIENT_ID=

# federated | direct — Azure access mode when using managed identity.
CLOUDSAVER_AZURE_ACCESS=federated

# Multi-tenant app registration client ID (federated Azure path).
CLOUDSAVER_AZURE_APP_CLIENT_ID=

# AWS hub role ARN (Entra issuer trust).
CLOUDSAVER_AWS_HUB_ROLE_ARN=
CLOUDSAVER_AWS_TOKEN_AUDIENCE=api://AzureADTokenExchange

# Full GCP workload identity provider resource name, e.g.
# //iam.googleapis.com/projects/<number>/locations/global/workloadIdentityPools/<pool>/providers/<provider>
CLOUDSAVER_GCP_WORKLOAD_PROVIDER=
CLOUDSAVER_GCP_TOKEN_AUDIENCE=api://AzureADTokenExchange

# CLOUDSAVER_CLOUD_IDENTITY=developer only: true bakes Azure CLI into service images.
CLOUDSAVER_INSTALL_AZURE_CLI=false

# Kubernetes Prometheus scrape tokens (operator-defined env names referenced from cluster config).
# CLOUDSAVER_PROMETHEUS_TOKEN_PRIMARY=

# -----------------------------------------------------------------------------
# Legacy client-secret credential path (not used with CLOUDSAVER_CLOUD_IDENTITY=managed_identity)
# -----------------------------------------------------------------------------

# env | keyvault
# CLOUDSAVER_CREDENTIAL_PROVIDER=env
# AZURE_CLIENT_SECRET=
# AZURE_KEYVAULT_URL=
# AZURE_KEYVAULT_AUTH=managed_identity
# AZURE_KEYVAULT_MANAGED_IDENTITY_CLIENT_ID=
# AZURE_KEYVAULT_CACHE_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Platform identity-service (runs in platform/; reached over Docker network platform-link)
# -----------------------------------------------------------------------------

# Base URL for all CloudSaver callers. Default on platform-link: http://identity-service:8005
CLOUDSAVER_IDENTITY_URL=http://identity-service:8005

# One secret token per service. setup_compose.py generates URL-safe values (never printed).
# Compose maps each to CLOUDSAVER_IDENTITY_TOKEN on the matching service.
CLOUDSAVER_IDENTITY_TOKEN_GATEWAY=
CLOUDSAVER_IDENTITY_TOKEN_TENANT=
CLOUDSAVER_IDENTITY_TOKEN_SCANNER=
CLOUDSAVER_IDENTITY_TOKEN_ANALYTICS=
CLOUDSAVER_IDENTITY_TOKEN_NOTIFICATION=

# Verify cache 0–30 seconds; invalidations via identity events long-poll. Default 15.
CLOUDSAVER_IDENTITY_CACHE_SECONDS=15

# Optional legacy second Redis for identity client cache (e.g. redis://redis:6379/2).
# Prefer platform PLATFORM_REDIS_URL for identity-service itself.
# CLOUDSAVER_IDENTITY_REDIS_URL=

# Store SHA-256 digests in platform/.env PLATFORM_IDENTITY_CALLERS (setup_platform.py --add-callers).

# -----------------------------------------------------------------------------
# Workspace keys and directory rollout
# -----------------------------------------------------------------------------

# local | shadow | identity — verification path for workspace API keys.
# setup_compose.py sets identity (fresh install). compose.yaml default if unset: shadow.
CLOUDSAVER_KEY_VERIFIER=identity

# registry | cutover — cutover requires CLOUDSAVER_KEY_VERIFIER=identity and database tenant registry.
# setup_compose.py sets cutover on fresh install.
CLOUDSAVER_DIRECTORY_MODE=cutover

# true | false — provider-limited workspace keys (mirrored on platform as PLATFORM_PROVIDER_SCOPED_KEYS).
# setup_compose.py sets true. compose.yaml default if unset: false.
CLOUDSAVER_PROVIDER_SCOPED_KEYS=true

# Seconds between directory projector polls. Default 5.
CLOUDSAVER_DIRECTORY_POLL_SECONDS=5

# Tenant registry in-memory cache TTL. Default 5.
CLOUDSAVER_REGISTRY_CACHE_SECONDS=5

# -----------------------------------------------------------------------------
# API authentication (CloudSaver services)
# -----------------------------------------------------------------------------

# workspace | entra
CLOUDSAVER_AUTH_MODE=workspace

# Required when CLOUDSAVER_AUTH_MODE=entra — API app (client) ID / token audience.
CLOUDSAVER_ENTRA_AUDIENCE=

# Comma-separated browser origins for CORS; empty disables CORS.
CLOUDSAVER_ALLOWED_ORIGINS=

# CLOUDSAVER_TRUSTED_CALLERS and CLOUDSAVER_TRUSTED_PROXIES are set in compose.yaml per service.

# -----------------------------------------------------------------------------
# Schedules, scans, and workers
# -----------------------------------------------------------------------------

# Platform switches. In database mode these seed once; change in platform portal (http://127.0.0.1:3100).
CLOUDSAVER_SCHEDULED_SCANS=false
CLOUDSAVER_AUTOMATED_ALERTS=false

# Beat interval for scheduled scans (seconds). Default 300.
CLOUDSAVER_SCHEDULER_TICK_SECONDS=300

# Standalone: false. Compose sets true on scanner-service for distributed scan leases.
CLOUDSAVER_DISTRIBUTED_SCAN_LOCK=false

# Durable interactive Azure jobs; requires scheduled profile (worker + dispatcher) and delivery enabled.
CLOUDSAVER_INTERACTIVE_JOBS=false

# -----------------------------------------------------------------------------
# GitOps and plan policy
# -----------------------------------------------------------------------------

# JSON array of approved repository bindings.
CLOUDSAVER_GITOPS_TARGETS=[]

# true enables GitHub App draft PR publishing.
CLOUDSAVER_GITOPS_PUBLISH=false
CLOUDSAVER_GITHUB_APP_ID=
CLOUDSAVER_GITHUB_APP_PRIVATE_KEY=

# Trusted JSON guardrails for Terraform, e.g. {"required_tags":["Owner"],"max_monthly_increase_usd":"100"}
CLOUDSAVER_PLAN_POLICY={}

# -----------------------------------------------------------------------------
# Delivery and notifications
# -----------------------------------------------------------------------------

# true enables the delivery dispatcher Compose profile.
CLOUDSAVER_DELIVERY_ENABLED=false

# JSON array; each target references a CLOUDSAVER_WEBHOOK_* env var by name (never put URLs in JSON).
CLOUDSAVER_NOTIFICATION_TARGETS=[]

# Example: [{"target_id":"finops","tenant_id":"<tenant-uuid>","channel":"slack","url_env":"CLOUDSAVER_WEBHOOK_PRIMARY"}]
CLOUDSAVER_WEBHOOK_PRIMARY=

# Pass additional CLOUDSAVER_WEBHOOK_* vars to scanner-service, delivery-dispatcher, and scan-worker via a private override.

# -----------------------------------------------------------------------------
# AI advisory (opt-in)
# See docs/ASSESSMENT_AI.md.
# Governed configuration, migrations and activation: docs/RESOURCE_ANALYSIS_FOUNDRY_IMPLEMENTATION.md.
# Platform policy and workspace consent are required in addition to this deployment switch.
# -----------------------------------------------------------------------------

CLOUDSAVER_AI_ENABLED=false
# Read-only retrieval of reviewed public/synthetic guidance from the separate Platform knowledge DB.
# If enabled, retrieval unavailability prevents chargeable inference rather than bypassing the gate.
CLOUDSAVER_KNOWLEDGE_ENABLED=false
# Tenant-bound operator templates; Azure governed targets also require an approved region.
# Users select these bindings in /settings/ai. Never put raw provider keys in this JSON.
CLOUDSAVER_AI_TARGETS=[]
CLOUDSAVER_AI_HOURLY_ATTEMPTS=10

# Worker batching (Compose sets these on scan-worker / ai-worker).
CLOUDSAVER_AI_BATCH_TICK_SECONDS=30
CLOUDSAVER_AI_BATCH_ITEMS_PER_TICK=10

# -----------------------------------------------------------------------------
# CLI and smoke scripts (not used by Compose)
# -----------------------------------------------------------------------------

# CLOUDSAVER_WORKSPACE_KEY=
# CLOUDSAVER_GATEWAY_URL=http://127.0.0.1:8000
# CLOUDSAVER_DASHBOARD_URL=http://127.0.0.1:3000
# CLOUDSAVER_LEGACY_KEY_DEADLINE=
# CLOUDSAVER_REGISTRY_EXPORT_URL=
