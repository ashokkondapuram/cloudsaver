# Documentation only: no file is loaded automatically.
CLOUDSAVER_MODE=demo
CLOUDSAVER_DB=data/cloudsaver.sqlite3
# Generate a random key with python -c "import secrets; print(secrets.token_urlsafe(32))"
DEMO_ACCESS_KEY=
# Live mode: use trusted operator configuration, never accept tenant/subscription IDs from requests.
CLOUDSAVER_TENANTS=[]
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Docker Compose only: generate separate URL-safe passwords, never commit .env.
POSTGRES_PASSWORD=
CLOUDSAVER_DB_PASSWORD=
# Optional aggregate-only notification destination configured by the operator.
CLOUDSAVER_NOTIFICATION_WEBHOOK=
