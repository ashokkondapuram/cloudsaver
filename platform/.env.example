# Platform 1.0.0 settings. Documentation only: generate the real file with
#   python3 scripts/setup_platform.py
# and never commit platform/.env. Every value below is an empty placeholder.

# platform-db (PostgreSQL 16). Separate, URL-safe passwords for the superuser, migration owner and runtime role.
PLATFORM_DB_PASSWORD=
PLATFORM_DB_OWNER_PASSWORD=
PLATFORM_DB_APP_PASSWORD=

# Workspace key pepper (hex, at least 32 bytes) and its version. In Azure it comes from Key Vault
# (secret cloudsaver-identity-key-pepper) through PLATFORM_KEYVAULT_URL instead.
PLATFORM_KEY_PEPPER=
PLATFORM_KEY_PEPPER_VERSION=1
PLATFORM_KEY_PEPPER_PREVIOUS=
PLATFORM_KEYVAULT_URL=

# SHA-256 digests of each caller's service token, as JSON {"gateway": "<digest>", ...}.
# CloudSaver's scripts/setup_compose.py generates its tokens; setup_platform.py --add-callers adds their digests.
PLATFORM_IDENTITY_CALLERS=
# The portal's own caller token (the platform keeps it; only its digest is in PLATFORM_IDENTITY_CALLERS).
PLATFORM_PORTAL_TOKEN=

# Operator sign-in: entra (production) or operator_key (local development only; refused in production).
PLATFORM_PORTAL_AUTH=entra
PLATFORM_OPERATOR_KEY_SHA256=
PLATFORM_OPERATOR_TENANT_ID=
PLATFORM_IDENTITY_AUDIENCE=api://cloudsaver-identity
PORTAL_ENTRA_TENANT_ID=
PORTAL_ENTRA_CLIENT_ID=
PORTAL_ENTRA_CLIENT_SECRET=
PLATFORM_PUBLIC_URL=http://127.0.0.1:3100
PLATFORM_ENVIRONMENT=development
PLATFORM_PROVIDER_SCOPED_KEYS=false

# Billing. With PLATFORM_BILLING_ENABLED=true, workspace plans come from customer subscriptions.
PLATFORM_BILLING_ENABLED=false
# manual (default) or stripe. Stripe also needs both secrets below (Key Vault in Azure:
# platform-stripe-secret-key and platform-stripe-webhook-secret); identity-service refuses to start without them.
PLATFORM_BILLING_PROVIDER=manual
PLATFORM_STRIPE_SECRET_KEY=
PLATFORM_STRIPE_WEBHOOK_SECRET=
