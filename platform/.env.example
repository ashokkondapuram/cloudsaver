# Platform 1.0 environment (documentation only — nothing loads this file automatically).
#
# Full reference: docs/ENVIRONMENT.md (paths relative to repo root)
# Generate a real, untracked platform/.env (mode 0600, never commit it):
#   (cd platform && python3 scripts/setup_platform.py)
# Allow CloudSaver service tokens (digests only stored here):
#   (cd platform && python3 scripts/setup_platform.py --add-callers ../.env)
# Local Docker from repo root: make platform-up (portal at http://127.0.0.1:3100).

# -----------------------------------------------------------------------------
# PostgreSQL (platform-db) — required for Compose
# -----------------------------------------------------------------------------

# URL-safe random passwords. setup_platform.py generates all three.
# Superuser (postgres container).
PLATFORM_DB_PASSWORD=

# Migration owner role identity_owner (identity-migrate job).
PLATFORM_DB_OWNER_PASSWORD=

# Runtime role identity_app.
PLATFORM_DB_APP_PASSWORD=

# Built in platform/compose.yaml from PLATFORM_DB_APP_PASSWORD / PLATFORM_DB_OWNER_PASSWORD — do not copy here:
#   PLATFORM_IDENTITY_DATABASE_URL
#   PLATFORM_IDENTITY_MIGRATION_URL

# Optional SQLAlchemy pool per identity-service process (Compose defaults: size 4, overflow 4).
PLATFORM_DB_POOL_SIZE=4
PLATFORM_DB_MAX_OVERFLOW=4
# Code defaults when unset: timeout 5, recycle 1800 (not in compose env block).
# PLATFORM_DB_POOL_TIMEOUT=5
# PLATFORM_DB_POOL_RECYCLE=1800

# -----------------------------------------------------------------------------
# Redis (platform-redis)
# -----------------------------------------------------------------------------

# Set in platform/compose.yaml for identity throttle and events: redis://platform-redis:6379/0
# Legacy alias accepted: CLOUDSAVER_IDENTITY_REDIS_URL

# -----------------------------------------------------------------------------
# Workspace key pepper
# -----------------------------------------------------------------------------

# Hex string, at least 32 bytes. setup_platform.py generates one.
# In Azure, load from Key Vault secret cloudsaver-identity-key-pepper via PLATFORM_KEYVAULT_URL instead.
PLATFORM_KEY_PEPPER=
PLATFORM_KEY_PEPPER_VERSION=1

# Comma-separated previous peppers for rotation (optional).
PLATFORM_KEY_PEPPER_PREVIOUS=

# Azure Key Vault URL (optional; replaces inline PLATFORM_KEY_PEPPER when set).
PLATFORM_KEYVAULT_URL=

# -----------------------------------------------------------------------------
# Identity-service callers and portal token
# -----------------------------------------------------------------------------

# JSON map of caller name → SHA-256 hex digest of that caller's bearer token (never store raw tokens).
# Keys: gateway, tenant, scanner, analytics, notification, portal.
# setup_platform.py seeds {"portal": "<digest>"}; add CloudSaver services with --add-callers ../.env
PLATFORM_IDENTITY_CALLERS=

# Portal → identity-service bearer token (secret). Only its digest appears in PLATFORM_IDENTITY_CALLERS.portal.
PLATFORM_PORTAL_TOKEN=

# Verify cache 0–30 seconds. Default 15 (matches CloudSaver CLOUDSAVER_IDENTITY_CACHE_SECONDS).
PLATFORM_IDENTITY_CACHE_SECONDS=15

# Token audience for issued workspace/portal tokens. Default api://cloudsaver-identity
PLATFORM_IDENTITY_AUDIENCE=api://cloudsaver-identity

# -----------------------------------------------------------------------------
# Portal URL and environment
# -----------------------------------------------------------------------------

# Public base URL for links and redirects (loopback for local Docker).
PLATFORM_PUBLIC_URL=http://127.0.0.1:3100

# development | production — development issues cs_test_ keys; operator_key auth is refused when production.
# setup_platform.py sets development for local Docker (portal top bar shows "Local", not "development").
PLATFORM_ENVIRONMENT=development

# true | false — provider-scoped workspace API keys.
# setup_platform.py sets true. compose.yaml default if unset: false.
PLATFORM_PROVIDER_SCOPED_KEYS=true

# -----------------------------------------------------------------------------
# Portal sign-in
# -----------------------------------------------------------------------------

# entra | operator_key
# setup_platform.py sets operator_key for local Docker (prints operator access key once).
# Use entra in production with the PORTAL_ENTRA_* variables below.
PLATFORM_PORTAL_AUTH=operator_key

# SHA-256 hex of operator access key (required when PLATFORM_PORTAL_AUTH=operator_key).
PLATFORM_OPERATOR_KEY_SHA256=

# Optional Entra tenant binding for operator flows.
PLATFORM_OPERATOR_TENANT_ID=

# Microsoft Entra app registration (when PLATFORM_PORTAL_AUTH=entra).
PORTAL_ENTRA_TENANT_ID=
PORTAL_ENTRA_CLIENT_ID=
PORTAL_ENTRA_CLIENT_SECRET=
PORTAL_ENTRA_API_SCOPE=api://cloudsaver-identity/.default

# Portal container also receives IDENTITY_SERVICE_URL and PORTAL_PUBLIC_URL from compose.yaml.

# -----------------------------------------------------------------------------
# Billing
# -----------------------------------------------------------------------------

# true | false — when true, workspace plans follow customer subscriptions.
# setup_platform.py sets true; platform/compose.yaml default if unset: false.
PLATFORM_BILLING_ENABLED=true

# manual | stripe — stripe requires both secrets below (or Key Vault) or identity-service will not start.
PLATFORM_BILLING_PROVIDER=manual

# Key Vault secret names: platform-stripe-secret-key, platform-stripe-webhook-secret
PLATFORM_STRIPE_SECRET_KEY=
PLATFORM_STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Identity verify throttle (optional tuning)
# Legacy CLOUDSAVER_IDENTITY_* names are still accepted.
# -----------------------------------------------------------------------------

# PLATFORM_IDENTITY_IP_FAILURES=30
# PLATFORM_IDENTITY_PAIR_FAILURES=5
# PLATFORM_IDENTITY_FAILURE_WINDOW_SECONDS=300
# PLATFORM_IDENTITY_BLOCK_SECONDS=900
# Optional, isolated knowledge service. Use distinct databases and runtime credentials.
# Pre-create knowledge_app as an unprivileged role and run knowledge migrations as its separate owner.
PLATFORM_KNOWLEDGE_DATABASE_URL=
PLATFORM_KNOWLEDGE_MIGRATION_URL=
